// Типы для проверки словарей: сама она на .mjs, потому что запускается
// напрямую через node, без сборки. Но её импортирует тест внутри src/, а
// tsc проверяет src/ строго — без этого файла сборка падает на implicit
// any. Тот же случай, что и у check-claims.d.mts: локальный vitest ничего
// не замечает (он не зовёт tsc), а сборка на Vercel возвращает 2.

export interface MissingKey {
  /** Ключ так, как он написан в t('…'). */
  key: string;
  /** Файлы, где он встречается, относительно src. */
  where: string[];
  /** Языки, в которых ключ не строка: 'fr' | 'en' | 'nl'. */
  missing: string[];
  /** Ключа нет вовсе или он оказался объектом. */
  reason: string;
}

/** Все ключи, найденные в коде: ключ → файлы, где он встречается. */
export function collectUsedKeys(): Map<string, string[]>;

/** Ключи, которых не хватает хотя бы в одном языке. Пусто = чисто. */
export function findMissingKeys(): MissingKey[];
