// Типы для храповика мёртвого груза: сам он на .mjs, потому что
// запускается напрямую через node. Импортирует его тест внутри src/, а
// tsc проверяет src/ строго — без этого файла сборка падает на implicit
// any (и падает именно на Vercel, потому что vitest не зовёт tsc).

/**
 * Снять комментарии.
 *
 * Упоминание файла в комментарии — это причина его удаления, а не
 * ссылка на него. Первая версия сторожа на этом и обманулась: нашла имя
 * файла в собственной шапке и объявила «чисто».
 */
export function stripComments(source: string): string;

/** Файлы в public/, на которые не ссылается ничто. Пусто = чисто. */
export function findUnused(): string[];

/** Сколько файлов в public/ просмотрено. Ноль = обход сломан. */
export function countScanned(): number;
