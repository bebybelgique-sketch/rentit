# .env.example
# Скопируйте этот файл в .env и заполните реальными значениями.
# Сам .env в git не попадает (см. .gitignore) — репозиторий публичный.

# Обязательное: без этого приложение не поднимется.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Сквозные проверки на живом проекте.
# Адрес по умолчанию задан в playwright.config.ts; переменная нужна,
# только чтобы прогнать набор против другого развёртывания.
E2E_BASE_URL=https://rentit-plum.vercel.app

# Постоянные учётки для сценариев Playwright. Домен @rentit-e2e.local
# нерабочий намеренно: письма туда не уходят. Эти учётки НЕ удаляются
# скриптом supabase/tests/cleanup_test_accounts.sql — он чистит домен
# @rentit-test.local, создаваемый прогонами на каждый запуск.
TEST_OWNER_EMAIL=e2e-owner@rentit-e2e.local
TEST_OWNER_PASSWORD=
TEST_RENTER_EMAIL=e2e-renter@rentit-e2e.local
TEST_RENTER_PASSWORD=

# Генерация типов базы: bash src/lib/generate-types.sh
# Идентификатор проекта из адреса https://<ref>.supabase.co. Нужен также
# вход в CLI (npx supabase login): gen types ходит в Management API.
SUPABASE_PROJECT_REF=

# Раздел admin-action в supabase/tests/edge-functions.mjs.
#
# Учётка с users.role = 'admin'. Роль ей выставляют ОДИН раз руками:
#   update public.users set role = 'admin' where id = '<uuid>';
# Из клиента это невозможно (гранты сняты миграцией 20260812000017), и
# ровно поэтому существует функция admin-action.
# Без этих двух переменных раздел ПРОПУСКАЕТСЯ с пометкой, а не молча.
TEST_ADMIN_EMAIL=e2e-admin@rentit-e2e.local
TEST_ADMIN_PASSWORD=

# Только для чтения admin_audit_log в прогоне: журнал закрыт для anon и
# authenticated намеренно (RLS без политик, гранты сняты). Без ключа
# проверки содержимого журнала пропускаются. В CI — секретом, в файл .env
# на своей машине; в репозиторий не попадает.
SUPABASE_SERVICE_ROLE_KEY=

# Ключей Stripe здесь нет и не должно быть: платформа денег не касается,
# расчёт наличными между сторонами.
