#!/bin/sh
#
# Быстрые гейты перед push.
#
# ЗАЧЕМ. GitHub Actions у проекта настроены (.github/workflows/gates.yml),
# но 14.08.2026 не запускаются: учётная запись заблокирована по оплате.
# А отказ, ради которого всё затевалось, реальный и уже случился — 13.08
# в main слились #30 и #31 при КРАСНОМ check-i18n-keys, и у каждого
# вошедшего пользователя в навбаре повисла служебная фраза i18next.
# Хук закрывает ровно этот отказ и от GitHub не зависит.
#
# ЧЕГО ЗДЕСЬ НЕТ И ПОЧЕМУ. Ни vitest, ни сборки. Обычно это сорок секунд,
# но 14.08 прогон юнит-тестов на этой машине разросся до 41 МИНУТЫ под
# нагрузкой (8 ГБ памяти). Хук, который иногда думает сорок минут,
# отключат в первый же день — и тогда не станет и остальных проверок.
# Замерено на этой машине: полный набор здесь — около 30 секунд, из них
# 7 приходится на tsc. Это цена, которую платят на каждом push.
# Полный набор — в CI, когда он оживёт, и вручную: npx vitest run.
#
# ОБХОД: git push --no-verify. Это осознанное действие, а не «забыл» —
# ровно та разница, ради которой хук и ставится.
#
# ВКЛЮЧЕНИЕ: git config core.hooksPath .githooks
# (делается само при npm install — см. скрипт prepare в package.json).

cd "$(git rev-parse --show-toplevel)" || exit 1

# Вывод проверки прячем, пока она зелёная, и показываем ЦЕЛИКОМ при
# падении. Иначе человек получает молчаливый отказ push без причины —
# тот самый класс «сообщил исход, не показав основания».
run_gate() {
  name="$1"; shift
  printf '  · %s' "$name"
  if out=$("$@" 2>&1); then
    printf ' — чисто\n'
  else
    printf ' — ПРОВАЛ\n\n%s\n\n' "$out"
    printf 'push остановлен. Починить — или, если решение осознанное:\n'
    printf '  git push --no-verify\n'
    exit 1
  fi
}

echo "▸ Гейты перед push (полный набор — npx vitest run)"

run_gate "страж утверждений"  node scripts/check-claims.mjs
run_gate "словари"            node scripts/check-i18n-keys.mjs
run_gate "текст мимо словарей" node scripts/check-hardcoded-text.mjs
# Прямой бинарник, а не npx: тот же результат, но без разрешения пакета
# на каждом запуске. Запасной путь — если хук зовут там, где зависимости
# лежат иначе.
if [ -x ./node_modules/.bin/tsc ]; then
  run_gate "типы"             ./node_modules/.bin/tsc --noEmit
else
  run_gate "типы"             npx tsc --noEmit
fi

echo "▸ Чисто."
